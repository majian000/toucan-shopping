    <description>接口监控定时任务模块（聚合、清理、DDL配置）</description>
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.toucan.shopping.modules.apiMonitor</groupId>
    <artifactId>toucan-shopping-api-monitor-job</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>com.toucan.shopping.modules.apiMonitor</groupId>
            <artifactId>toucan-shopping-api-monitor-service-dao</artifactId>
        </dependency>
        <!-- Druid 数据源：RawDataSourceConfig 需要 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid</artifactId>
            <version>1.2.23</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*</include>
                </includes>
            </resource>
        </resources>
    </build>
