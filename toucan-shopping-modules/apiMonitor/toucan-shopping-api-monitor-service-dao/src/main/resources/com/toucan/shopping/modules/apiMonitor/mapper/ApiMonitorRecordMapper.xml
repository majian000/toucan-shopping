<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.toucan.shopping.modules.apiMonitor.mapper.ApiMonitorRecordMapper">

    <resultMap id="BaseResultMap" type="com.toucan.shopping.modules.apiMonitor.entity.ApiMonitorRecordPO">
        <id column="id" property="id"/>
        <result column="api_url" property="apiUrl"/>
        <result column="http_method" property="httpMethod"/>
        <result column="elapsed_ms" property="elapsedMs"/>
        <result column="status_code" property="statusCode"/>
        <result column="trace_id" property="traceId"/>
        <result column="app_name" property="appName"/>
        <result column="server_ip" property="serverIp"/>
        <result column="request_time" property="requestTime"/>
        <result column="sharding_date" property="shardingDate"/>
        <result column="create_date" property="createDate"/>
    </resultMap>

    <resultMap id="SummaryResultMap" type="com.toucan.shopping.modules.apiMonitor.entity.ApiMonitorSummaryPO">
        <result column="api_url" property="apiUrl"/>
        <result column="app_name" property="appName"/>
        <result column="request_count" property="requestCount"/>
        <result column="avg_ms" property="avgMs"/>
        <result column="max_ms" property="maxMs"/>
        <result column="min_ms" property="minMs"/>
    </resultMap>

    <!-- 批量插入 -->
    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO api_monitor_record
        (id, api_url, http_method, elapsed_ms, status_code, trace_id, app_name, server_ip, request_time, sharding_date)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.id}, #{item.apiUrl}, #{item.httpMethod}, #{item.elapsedMs}, #{item.statusCode},
             #{item.traceId}, #{item.appName}, #{item.serverIp}, #{item.requestTime}, #{item.shardingDate})
        </foreach>
    </insert>

    <!-- 慢请求列表 -->
    <select id="selectSlowList" resultMap="BaseResultMap">
        SELECT * FROM api_monitor_record
        WHERE elapsed_ms <![CDATA[ >= ]]> #{minElapsedMs}
        <if test="apiUrl != null and apiUrl != ''">
            AND api_url = #{apiUrl}
        </if>
        <if test="appName != null and appName != ''">
            AND app_name = #{appName}
        </if>
        <if test="startTime != null">
            AND request_time <![CDATA[ >= ]]> #{startTime}
        </if>
        <if test="endTime != null">
            AND request_time <![CDATA[ < ]]> #{endTime}
        </if>
        <if test="traceId != null and traceId != ''">
            AND trace_id = #{traceId}
        </if>
        ORDER BY request_time DESC
        <if test="offset != null and limit != null">
            LIMIT #{offset}, #{limit}
        </if>
    </select>

    <!-- 统计慢请求总数 -->
    <select id="countSlowList" resultType="long">
        SELECT COUNT(*) FROM api_monitor_record
        WHERE elapsed_ms <![CDATA[ >= ]]> #{minElapsedMs}
        <if test="apiUrl != null and apiUrl != ''">
            AND api_url = #{apiUrl}
        </if>
        <if test="appName != null and appName != ''">
            AND app_name = #{appName}
        </if>
        <if test="startTime != null">
            AND request_time <![CDATA[ >= ]]> #{startTime}
        </if>
        <if test="endTime != null">
            AND request_time <![CDATA[ < ]]> #{endTime}
        </if>
        <if test="traceId != null and traceId != ''">
            AND trace_id = #{traceId}
        </if>
    </select>

    <!-- 概要统计（直接对原始记录表按接口+应用聚合） -->
    <select id="selectSummary" resultMap="SummaryResultMap">
        SELECT
            api_url,
            app_name,
            COUNT(*) AS request_count,
            ROUND(AVG(elapsed_ms), 2) AS avg_ms,
            MAX(elapsed_ms) AS max_ms,
            MIN(elapsed_ms) AS min_ms
        FROM api_monitor_record
        WHERE request_time <![CDATA[ >= ]]> #{startTime}
          AND request_time <![CDATA[ < ]]> #{endTime}
        <if test="apiUrl != null and apiUrl != ''">
            AND api_url LIKE CONCAT('%', #{apiUrl}, '%')
        </if>
        <if test="appName != null and appName != ''">
            AND app_name LIKE CONCAT('%', #{appName}, '%')
        </if>
        GROUP BY api_url, app_name
        <if test="minElapsed != null and minElapsed > 0">
            HAVING avg_ms <![CDATA[ >= ]]> #{minElapsed}
        </if>
        ORDER BY avg_ms DESC
    </select>

    <!-- 删除过期数据 -->
    <delete id="deleteByCreateDate">
        DELETE FROM api_monitor_record WHERE create_date <![CDATA[ < ]]> #{beforeDate}
    </delete>

</mapper>
