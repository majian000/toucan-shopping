<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.toucan.shopping.modules.apiMonitor.mapper.ApiMonitorMetricsMapper">

    <resultMap id="BaseResultMap" type="com.toucan.shopping.modules.apiMonitor.entity.ApiMonitorMetricsPO">
        <id column="id" property="id"/>
        <result column="api_url" property="apiUrl"/>
        <result column="app_name" property="appName"/>
        <result column="time_window" property="timeWindow"/>
        <result column="request_count" property="requestCount"/>
        <result column="avg_ms" property="avgMs"/>
        <result column="max_ms" property="maxMs"/>
        <result column="min_ms" property="minMs"/>
        <result column="sharding_date" property="shardingDate"/>
        <result column="create_date" property="createDate"/>
    </resultMap>

    <!-- 概要统计 -->
    <select id="selectSummary" resultMap="BaseResultMap">
        SELECT
            api_url,
            app_name,
            SUM(request_count) AS request_count,
            ROUND(SUM(request_count * avg_ms) / SUM(request_count), 2) AS avg_ms,
            MAX(max_ms) AS max_ms,
            MIN(min_ms) AS min_ms
        FROM api_monitor_metrics
        WHERE time_window <![CDATA[ >= ]]> #{startTime}
          AND time_window <![CDATA[ < ]]> #{endTime}
        <if test="apiUrl != null and apiUrl != ''">
            AND api_url = #{apiUrl}
        </if>
        <if test="appName != null and appName != ''">
            AND app_name = #{appName}
        </if>
        GROUP BY api_url, app_name
        ORDER BY avg_ms DESC
    </select>

    <!-- 趋势查询 -->
    <select id="selectTrend" resultMap="BaseResultMap">
        SELECT * FROM api_monitor_metrics
        WHERE time_window <![CDATA[ >= ]]> #{startTime}
          AND time_window <![CDATA[ < ]]> #{endTime}
        <if test="apiUrl != null and apiUrl != ''">
            AND api_url = #{apiUrl}
        </if>
        <if test="appName != null and appName != ''">
            AND app_name = #{appName}
        </if>
        ORDER BY time_window DESC
    </select>

    <!-- 查询已聚合的最新时间窗口（用于故障恢复追赶） -->
    <select id="selectMaxTimeWindow" resultType="java.util.Date">
        SELECT COALESCE(MAX(time_window), '1970-01-01 00:00:00') FROM api_monitor_metrics
    </select>

    <!-- 查询已存在的窗口 keys，用于 Java 侧去重 -->
    <select id="selectExistingKeys" resultMap="BaseResultMap">
        SELECT api_url, app_name, time_window FROM api_monitor_metrics
        WHERE time_window <![CDATA[ >= ]]> #{startTime}
          AND time_window <![CDATA[ < ]]> #{endTime}
    </select>

    <!-- 批量插入聚合结果 -->
    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO api_monitor_metrics
        (id, api_url, app_name, time_window, request_count, avg_ms, max_ms, min_ms, sharding_date)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.id}, #{item.apiUrl}, #{item.appName}, #{item.timeWindow},
             #{item.requestCount}, #{item.avgMs}, #{item.maxMs}, #{item.minMs}, #{item.shardingDate})
        </foreach>
    </insert>

    <!-- 删除过期数据 -->
    <delete id="deleteByCreateDate">
        DELETE FROM api_monitor_metrics WHERE create_date <![CDATA[ < ]]> #{beforeDate}
    </delete>

</mapper>
