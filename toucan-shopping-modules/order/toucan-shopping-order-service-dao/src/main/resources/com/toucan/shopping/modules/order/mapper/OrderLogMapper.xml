<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org/DTD Mapper 3.0" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.toucan.shopping.modules.order.mapper.OrderLogMapper">

    <resultMap id="orderLogMap" type="com.toucan.shopping.modules.order.entity.OrderLog" >
        <id column="id" jdbcType="BIGINT"  property="id" />
        <result column="order_no" jdbcType="VARCHAR" property="orderNo" />
        <result column="batch_id" jdbcType="VARCHAR" property="batchId" />
        <result column="operate_user_id" jdbcType="VARCHAR" property="operateUserId" />
        <result column="data_body" jdbcType="VARCHAR" property="dataBody" />
        <result column="remark" jdbcType="VARCHAR" property="remark" />
        <result column="create_date" jdbcType="TIMESTAMP" property="createDate" />
        <result column="app_code" jdbcType="VARCHAR" property="appCode" />
        <result column="type" jdbcType="INTEGER" property="type" />
        <result column="delete_status" jdbcType="INTEGER" property="deleteStatus" />
        <result column="sharding_date" jdbcType="TIMESTAMP" property="shardingDate" />
    </resultMap>


    <resultMap id="orderLogVOMap" type="com.toucan.shopping.modules.order.vo.OrderLogVO" extends="orderLogMap">

    </resultMap>

    <sql id="queryListPageWhere">

        <if test="orderNo!=null and orderNo!=-1 ">
            and t.order_no = #{orderNo}
        </if>

        and delete_status = 0

    </sql>



    <insert id="insert" parameterType="com.toucan.shopping.modules.order.entity.OrderLog" >
        insert into t_order_log(id,order_no,batch_id,type,operate_user_id,data_body,remark,create_date,app_code,delete_status,sharding_date)
        values(#{id},#{orderNo},#{batchId},#{type},#{operateUserId},#{dataBody},#{remark},#{createDate},#{appCode},0,#{shardingDate})
    </insert>




    <insert id="inserts" parameterType="com.toucan.shopping.modules.order.entity.OrderLog"  >
        insert into t_order_log(id,order_no,batch_id,type,operate_user_id,data_body,remark,create_date,app_code,delete_status,sharding_date)
        values
        <foreach collection="entitys" item="entity" separator=",">
            (#{entity.id},#{entity.orderNo},#{entity.batchId},#{entity.type},#{entity.operateUserId},#{entity.dataBody},#{entity.remark},#{entity.createDate},#{entity.appCode},0,#{entity.shardingDate})
        </foreach>

    </insert>



    <select id="queryListPage" resultMap="orderLogMap" parameterType="com.toucan.shopping.modules.order.page.OrderLogPageInfo">
        select t.* from t_order_log t
        <where>
            1=1 and t.delete_status = 0

            <include refid="queryListPageWhere" />

        </where>
        order by t.id desc
        limit #{start},#{limit}
    </select>



    <select id="queryListPageCount" resultType="java.lang.Long" parameterType="com.toucan.shopping.modules.order.page.OrderLogPageInfo">
        select count(*) from t_order_log t
        <where>
            1=1 and t.delete_status = 0

            <include refid="queryListPageWhere" />

        </where>

    </select>


</mapper>