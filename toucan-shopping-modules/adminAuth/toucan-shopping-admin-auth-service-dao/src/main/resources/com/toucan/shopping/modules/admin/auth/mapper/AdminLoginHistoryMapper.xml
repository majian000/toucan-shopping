<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org/DTD Mapper 3.0" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.toucan.shopping.modules.admin.auth.mapper.AdminLoginHistoryMapper">

    <resultMap id="adminLoginHistoryMap" type="com.toucan.shopping.modules.admin.auth.entity.AdminLoginHistory" >
        <id column="id" jdbcType="BIGINT"  property="id" />
        <result column="admin_id" jdbcType="VARCHAR" property="adminId" />
        <result column="app_code" jdbcType="VARCHAR" property="appCode" />
        <result column="create_date" jdbcType="TIMESTAMP" property="createDate" />
        <result column="ip" jdbcType="VARCHAR" property="ip" />
        <result column="delete_status" jdbcType="INTEGER" property="deleteStatus" />
        <result column="login_src_type" jdbcType="INTEGER" property="loginSrcType" />

    </resultMap>

    <resultMap id="adminLoginHistoryVOMap" type="com.toucan.shopping.modules.admin.auth.vo.AdminLoginHistoryVO" extends="adminLoginHistoryMap" >
        <result column="admin_name" jdbcType="VARCHAR" property="adminName" />
    </resultMap>



    <insert id="insert" parameterType="com.toucan.shopping.modules.admin.auth.entity.AdminLoginHistory" useGeneratedKeys="true" keyProperty="id" >
        insert into t_sa_admin_login_history(id,admin_id,app_code,ip,create_date,delete_status,login_src_type)
        values(#{id},#{adminId},#{appCode},#{ip},#{createDate},#{deleteStatus},#{loginSrcType})
    </insert>

    <select id="queryListPage" resultMap="adminLoginHistoryVOMap">
        select h.*, a.username as admin_name
        from t_sa_admin_login_history h
        left join t_sa_admin a on h.admin_id = a.admin_id and a.delete_status = 0
        where h.delete_status = 0
        <if test="adminId != null and adminId != ''">
            and h.admin_id = #{adminId}
        </if>
        <if test="adminName != null and adminName != ''">
            and a.username like concat(#{adminName},'%')
        </if>
        <if test="appCode != null and appCode != ''">
            and h.app_code = #{appCode}
        </if>
        <if test="ip != null and ip != ''">
            and h.ip like concat(#{ip},'%')
        </if>
        <if test="loginSrcType != null">
            and h.login_src_type = #{loginSrcType}
        </if>
        <if test="startDate != null">
            and h.create_date &gt;= #{startDate}
        </if>
        <if test="endDate != null">
            and h.create_date &lt;= #{endDate}
        </if>
        order by h.create_date desc
        limit #{start},#{limit}
    </select>

    <select id="queryListPageCount" resultType="java.lang.Long">
        select count(1)
        from t_sa_admin_login_history h
        left join t_sa_admin a on h.admin_id = a.admin_id and a.delete_status = 0
        where h.delete_status = 0
        <if test="adminId != null and adminId != ''">
            and h.admin_id = #{adminId}
        </if>
        <if test="adminName != null and adminName != ''">
            and a.username like concat(#{adminName},'%')
        </if>
        <if test="appCode != null and appCode != ''">
            and h.app_code = #{appCode}
        </if>
        <if test="ip != null and ip != ''">
            and h.ip like concat(#{ip},'%')
        </if>
        <if test="loginSrcType != null">
            and h.login_src_type = #{loginSrcType}
        </if>
        <if test="startDate != null">
            and h.create_date &gt;= #{startDate}
        </if>
        <if test="endDate != null">
            and h.create_date &lt;= #{endDate}
        </if>
    </select>

    <select id="findListByEntity" resultMap="adminLoginHistoryMap">
        select *
        from t_sa_admin_login_history
        where delete_status = 0
        <if test="id != null">
            and id = #{id}
        </if>
        <if test="adminId != null and adminId != ''">
            and admin_id = #{adminId}
        </if>
        <if test="appCode != null and appCode != ''">
            and app_code = #{appCode}
        </if>
        <if test="ip != null and ip != ''">
            and ip = #{ip}
        </if>
        <if test="loginSrcType != null">
            and login_src_type = #{loginSrcType}
        </if>
        order by create_date desc
    </select>

</mapper>