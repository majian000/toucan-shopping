<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org/DTD Mapper 3.0" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.toucan.shopping.modules.admin.auth.mapper.AdminInfoMapper">

    <resultMap id="adminInfoMap" type="com.toucan.shopping.modules.admin.auth.entity.AdminInfo" >
        <id column="id" jdbcType="BIGINT" property="id" />
        <result column="admin_id" jdbcType="VARCHAR" property="adminId" />
        <result column="real_name" jdbcType="VARCHAR" property="realName" />
        <result column="phone" jdbcType="VARCHAR" property="phone" />
        <result column="email" jdbcType="VARCHAR" property="email" />
        <result column="gender" jdbcType="INTEGER" property="gender" />
        <result column="avatar" jdbcType="VARCHAR" property="avatar" />
        <result column="id_card" jdbcType="VARCHAR" property="idCard" />
        <result column="birthday" jdbcType="TIMESTAMP" property="birthday" />
        <result column="address" jdbcType="VARCHAR" property="address" />
        <result column="delete_status" jdbcType="INTEGER" property="deleteStatus" />
        <result column="create_admin_id" jdbcType="VARCHAR" property="createAdminId" />
        <result column="create_date" jdbcType="TIMESTAMP" property="createDate" />
        <result column="update_admin_id" jdbcType="VARCHAR" property="updateAdminId" />
        <result column="update_date" jdbcType="TIMESTAMP" property="updateDate" />
    </resultMap>

    <insert id="insert" parameterType="com.toucan.shopping.modules.admin.auth.entity.AdminInfo" useGeneratedKeys="true" keyProperty="id" >
        insert into t_sa_admin_info(id,admin_id,real_name,phone,email,gender,avatar,id_card,birthday,address,delete_status,create_admin_id,create_date,update_admin_id,update_date)
        values(#{id},#{adminId},#{realName},#{phone},#{email},#{gender},#{avatar},#{idCard},#{birthday},#{address},#{deleteStatus},#{createAdminId},#{createDate},#{updateAdminId},#{updateDate})
    </insert>

    <update id="update" parameterType="com.toucan.shopping.modules.admin.auth.entity.AdminInfo">
        update t_sa_admin_info
        set real_name = #{realName},
            phone = #{phone},
            email = #{email},
            gender = #{gender},
            avatar = #{avatar},
            id_card = #{idCard},
            birthday = #{birthday},
            address = #{address},
            update_admin_id = #{updateAdminId},
            update_date = #{updateDate}
        where admin_id = #{adminId} and delete_status = 0
    </update>

    <select id="findByAdminId" resultMap="adminInfoMap">
        select * from t_sa_admin_info where admin_id = #{adminId} and delete_status = 0
    </select>

</mapper>
