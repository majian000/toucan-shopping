<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <parent>
        <artifactId>toucan-shopping-cloud</artifactId>
        <groupId>com.toucan.shopping</groupId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <description>接口监控服务</description>
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.toucan.shopping.services</groupId>
    <artifactId>toucan-shopping-api-monitor</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
            <version>${nacos-server-version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
        </dependency>
        <dependency>
            <groupId>com.toucan.shopping.modules.common</groupId>
            <artifactId>toucan-shopping-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.toucan.shopping.modules.common</groupId>
            <artifactId>toucan-shopping-log</artifactId>
        </dependency>
        <dependency>
            <groupId>com.toucan.shopping.modules.common</groupId>
            <artifactId>toucan-shopping-log-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.toucan.shopping.cloud.modules.config</groupId>
            <artifactId>toucan-shopping-cloud-config-bootstrap</artifactId>
        </dependency>
        <dependency>
            <groupId>com.toucan.shopping.modules.apiMonitor</groupId>
            <artifactId>toucan-shopping-api-monitor-controller</artifactId>
        </dependency>
        <dependency>
            <groupId>com.toucan.shopping.modules.apiMonitor</groupId>
            <artifactId>toucan-shopping-api-monitor-business-service</artifactId>
        </dependency>
        <dependency>
            <groupId>com.toucan.shopping.modules.apiMonitor</groupId>
            <artifactId>toucan-shopping-api-monitor-job</artifactId>
        </dependency>
        <dependency>
            <groupId>com.toucan.shopping.modules.apiMonitor</groupId>
            <artifactId>toucan-shopping-api-monitor-service-dao</artifactId>
        </dependency>
        <dependency>
            <groupId>com.toucan.shopping.cloud.starter</groupId>
            <artifactId>toucan-shopping-xss-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.toucan.shopping.modules.common</groupId>
            <artifactId>toucan-shopping-db-sharding</artifactId>
        </dependency>

<!--        <dependency>-->
<!--            <groupId>com.toucan.shopping.cloud.starter</groupId>-->
<!--            <artifactId>toucan-shopping-api-monitor-spring-boot-starter</artifactId>-->
<!--        </dependency>-->
        <dependency>
            <groupId>com.toucan.shopping.cloud.starter</groupId>
            <artifactId>toucan-shopping-trace-id-micrometer-spring-boot-starter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.toucan.shopping.cloud.apiMonitor.CloudApiMonitorServiceApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals><goal>repackage</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes><include>**/*</include></includes>
            </resource>
        </resources>
    </build>
</project>
