                </dependency>


                <dependency>
                    <groupId>com.toucan.shopping.cloud.api</groupId>
                    <artifactId>toucan-shopping-order-api-cloud</artifactId>
                </dependency>



                <dependency>
                    <groupId>com.toucan.shopping.cloud.api</groupId>
                    <artifactId>toucan-shopping-search-api-cloud</artifactId>
                </dependency>


                <dependency>
                    <groupId>com.toucan.shopping.cloud.api</groupId>
                    <artifactId>toucan-shopping-api-monitor-api-cloud</artifactId>
                </dependency>




                <dependency>
                    <groupId>com.toucan.shopping.cloud.modules.apps.config</groupId>
                    <artifactId>toucan-shopping-admin-cloud-config</artifactId>
                </dependency>


                <!--使用了openFeign相关 -->
                <dependency>
                    <groupId>com.toucan.shopping.cloud.starter</groupId>
                    <artifactId>toucan-shopping-trace-id-micrometer-spring-boot-starter</artifactId>
                </dependency>

            </dependencies>
        </profile>
        <profile>
            <id>single</id>
            <activation>
                <property>
                    <name>deploy.mode</name>
                    <value>single</value>
                </property>
            </activation>
            <dependencies>

                <dependency>
                    <groupId>com.toucan.shopping.cloud.modules.apps.config</groupId>
                    <artifactId>toucan-shopping-admin-single-config</artifactId>
                </dependency>





                <dependency>
                    <groupId>com.toucan.shopping.cloud.api</groupId>
                    <artifactId>toucan-shopping-user-api-single</artifactId>
                </dependency>


                <dependency>
                    <groupId>com.toucan.shopping.cloud.api</groupId>
                    <artifactId>toucan-shopping-admin-auth-api-single</artifactId>
                </dependency>


                <dependency>
                    <groupId>com.toucan.shopping.cloud.api</groupId>
                    <artifactId>toucan-shopping-message-api-single</artifactId>
                </dependency>



                <dependency>
                    <groupId>com.toucan.shopping.cloud.api</groupId>
                    <artifactId>toucan-shopping-common-data-api-single</artifactId>
