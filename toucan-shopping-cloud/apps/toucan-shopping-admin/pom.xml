                </dependency>




                <dependency>
                    <groupId>com.toucan.shopping.cloud.api</groupId>
                    <artifactId>toucan-shopping-product-api-single</artifactId>
                </dependency>


                <dependency>
                    <groupId>com.toucan.shopping.cloud.api</groupId>
                    <artifactId>toucan-shopping-seller-api-single</artifactId>
                </dependency>


                <dependency>
                    <groupId>com.toucan.shopping.cloud.api</groupId>
