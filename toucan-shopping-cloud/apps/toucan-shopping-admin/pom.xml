    <profiles>
        <profile>
            <id>cloud</id>
            <activation>
                <property>
                    <name>deploy.mode</name>
                    <value>cloud</value>
                </property>
            </activation>
            <dependencies>

                <dependency>
                    <groupId>com.toucan.shopping.cloud.modules.config</groupId>
                    <artifactId>toucan-shopping-cloud-config-bootstrap</artifactId>
                </dependency>


                <dependency>
                    <groupId>com.toucan.shopping.cloud.api</groupId>
                    <artifactId>toucan-shopping-user-api-cloud</artifactId>
                </dependency>


                <dependency>
                    <groupId>com.toucan.shopping.cloud.api</groupId>
